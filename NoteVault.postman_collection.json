{
	"info": {
		"_postman_id": "notevault-collection-v1",
		"name": "NoteVault API",
		"description": "Comprehensive Postman collection for NoteVault REST APIs including User Authentication (JWT) and Personal Notes Management with User Data Privacy.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "note_id",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('jwt_token', jsonData.data.token);",
									"        console.log('Saved jwt_token:', jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						},
						"description": "Registers a new user and automatically extracts the returned JWT token into the collection variable `jwt_token`."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('jwt_token', jsonData.data.token);",
									"        console.log('Updated jwt_token:', jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						},
						"description": "Authenticates user and stores the Bearer JWT token into `jwt_token`."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Notes Management",
			"item": [
				{
					"name": "Create Note",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.id) {",
									"        pm.collectionVariables.set('note_id', jsonData.data.id);",
									"        console.log('Saved note_id:', jsonData.data.id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Java 21 and Spring Boot 3\",\n  \"content\": \"Key concepts to learn: Spring Security, JPA relationships, Streams, and JWT authorization.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/notes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes"
							]
						},
						"description": "Creates a note belonging to the authenticated user. Saves `note_id` for subsequent requests."
					},
					"response": []
				},
				{
					"name": "Get All Notes",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes"
							]
						},
						"description": "Retrieves all notes owned by the caller."
					},
					"response": []
				},
				{
					"name": "Search Notes by Title",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notes?search=java",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes"
							],
							"query": [
								{
									"key": "search",
									"value": "java"
								}
							]
						},
						"description": "Filters notes by title containing the keyword 'java'."
					},
					"response": []
				},
				{
					"name": "Get Note by ID",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notes/{{note_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Fetches a single note by its ID, enforcing ownership."
					},
					"response": []
				},
				{
					"name": "Update Note",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Java 21 and Spring Boot 3 - Updated\",\n  \"content\": \"Revised content with additional insights on clean architecture and unit tests.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/notes/{{note_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Updates an existing note owned by the caller."
					},
					"response": []
				},
				{
					"name": "Delete Note",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notes/{{note_id}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes",
								"{{note_id}}"
							]
						},
						"description": "Permanently deletes a note owned by the caller."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Negative & Validation Tests",
			"item": [
				{
					"name": "Register - Duplicate Email (409 Conflict)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"John Duplicate\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Login - Invalid Password (401 Unauthorized)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"wrongPassword!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							]
						}
					},
					"response": []
				},
				{
					"name": "Notes - Unauthorized Access without Token (401)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/notes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes"
							]
						}
					},
					"response": []
				},
				{
					"name": "Create Note - Blank Fields (400 Bad Request)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"\",\n  \"content\": \"\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/notes",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"notes"
							]
						}
					},
					"response": []
				}
			]
		}
	]
}
